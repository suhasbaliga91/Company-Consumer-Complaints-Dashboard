# ─── e-Jagriti scraper — environment variable reference ──────────────────────
#
# Copy this file to .env (or export the vars in your shell) before running the
# pipeline.  All variables are optional unless marked REQUIRED.
#
# Canonical reference: scraper/README.md § LLM Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM credentials (set at least ONE) ───────────────────────────────────────

# Google AI / Gemini API key (direct access — recommended)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-ai-key-here

# Optional: base URL for a self-hosted Gemini-compatible proxy endpoint.
# When set, GEMINI_API_KEY is used as the auth token for the proxy.
GEMINI_BASE_URL=

# OpenAI API key (or key for any OpenAI-compatible API)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# Optional: custom base URL for an OpenAI-compatible API (Azure, local proxy, etc.)
OPENAI_BASE_URL=

# ── LLM model selection (optional — auto-detected from credentials above) ─────

# Which provider to use first: "gemini" or "openai"
# Default: auto-detected from whichever credential is present (Gemini preferred)
LLM_PRIMARY_PROVIDER=gemini

# Model name for the primary provider
# Default: gemini-2.5-flash-lite (Gemini) or gpt-4o-mini (OpenAI)
LLM_PRIMARY_MODEL=gemini-2.5-flash-lite

# Fallback provider (used if primary fails): "gemini" or "openai"
# Default: the other provider
LLM_FALLBACK_PROVIDER=openai

# Model name for the fallback provider
# Default: gpt-4o-mini (OpenAI) or gemini-2.5-flash-lite (Gemini)
LLM_FALLBACK_MODEL=gpt-4o-mini

# ── Company / target configuration ───────────────────────────────────────────

# REQUIRED: search term sent to the e-Jagriti registry API (uppercase, as it
# appears in court records).  Also used as the default for COMPANY_NAME below.
OPPOSITE_PARTY=ACME MOTORS

# Human-readable company name injected into the LLM extraction prompt.
# Set to match the target company so the model knows whose cases it analyses.
# Defaults to OPPOSITE_PARTY if not set.
COMPANY_NAME=Acme Motors

# Set to "1" to keep only cases where the company is the respondent;
# "0" (default) keeps cases on either side.
RESPONDENT_ONLY=0

# Filing-year window to harvest (inclusive)
YEAR_FROM=2015
YEAR_TO=2026

# Comma-separated e-Jagriti state codes to restrict the run to (blank = all India).
# Example: "10" = Bihar only; "10,27" = Bihar + Maharashtra.
# Useful for test runs before a full national sweep.
RESTRICT_STATE_CODES=

# ── Database ──────────────────────────────────────────────────────────────────

# REQUIRED for the API server and all pg-backed scraper scripts.
# PostgreSQL connection string, e.g.:
#   postgres://user:password@localhost:5432/ejagriti
# Leave blank to use the local SQLite fallback (scraper scripts only).
DATABASE_URL=postgres://user:password@localhost:5432/ejagriti

# REQUIRED for scraper/sync_to_prod.py — the production PostgreSQL instance.
# If absent the script exits cleanly (safe to leave blank for local dev).
PROD_DATABASE_URL=

# ── API server / dashboard sync ───────────────────────────────────────────────

# Base URL of the API server, used by refresh.py to invalidate the dashboard
# cache after each pipeline run.  Leave blank to skip cache invalidation.
# Example: https://your-api-server.example.com
API_BASE_URL=

# Shared secret for POST /api/cache/invalidate.
# Must match the value set on the API server.  Leave blank to skip invalidation.
CACHE_SECRET=change-me-to-a-random-secret

# ── Cost guard ────────────────────────────────────────────────────────────────

# Hard daily LLM spend cap in USD.  All extraction stops once this is exceeded.
# Default: 10.0 (USD)
TOKEN_DAILY_CAP_USD=10.0

# ── Legacy aliases (still accepted; canonical names above are preferred) ──────

# EXTRACT_MODEL      → LLM_PRIMARY_MODEL
# OPENAI_EXTRACT_MODEL → LLM_FALLBACK_MODEL
