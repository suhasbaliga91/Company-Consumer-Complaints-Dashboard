# ─── Dashboard — environment variable reference ───────────────────────────────
#
# These are read at build/dev time by vite.config.ts (BASE_PATH, PORT) and at
# runtime by the built app via import.meta.env (VITE_-prefixed ones).
# Copy to .env, or export them in your shell, before running `pnpm run dev`/`build`.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Vite's `base` — the URL path the app is served under.
# Use "/" for a root deployment, or "/some-prefix/" for a subpath deployment.
BASE_PATH=/

# REQUIRED for `pnpm run dev` / `pnpm run serve` only (not for `build`).
# Dev/preview server port.
PORT=3000

# ── Branding (optional — defaults to "Consumer Cases Monitor" / "Case Monitor") ─

# Full app title, shown in the header (desktop), <title>, and social meta tags.
VITE_APP_TITLE=

# Short app title, shown in the header on mobile widths. Defaults to
# VITE_APP_TITLE (or "Case Monitor" if that's unset too).
VITE_APP_TITLE_SHORT=

# Meta description for the page/social previews. Defaults to VITE_APP_TITLE
# (or the built-in description if VITE_APP_TITLE is unset too).
VITE_APP_DESCRIPTION=

# ── API server location (optional) ──────────────────────────────────────────

# Base URL of the API server, e.g. https://api.example.com. Leave blank when
# the dashboard and API server share an origin (e.g. behind one reverse
# proxy) — all API calls stay relative in that case, which is the default.
VITE_API_BASE_URL=
